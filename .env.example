# Offline is explicit and requires no API key. It is NOT an LLM.
FLIGHT_AGENT_PROVIDER=fake
# Required only for --provider gemini (Gemini Developer API / AI Studio key).
# GOOGLE_API_KEY is also accepted and takes precedence if both keys are set.
# ReAct uses function calling; plan_execute/hybrid use native JSON schema.
GEMINI_API_KEY=
MODEL_NAME  =
GOOGLE_GENAI_USE_VERTEXAI=false
# Use fake profiles only: real mode sends conversation/passenger data to Google.
